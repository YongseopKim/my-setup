            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/dragon/github/YongseopKim/Claude-Code-Remote/claude-hook-notify.js completed",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/dragon/github/YongseopKim/Claude-Code-Remote/claude-hook-notify.js permission",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
